{
  "name": "streakup-monorepo",
  "version": "1.0.0",
  "description": "StreakUp - Microservices-Based Habit Tracking Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:all": "npx concurrently -n \"GATEWAY,AUTH,HABITS,ANALYTICS,NOTIFY\" -c \"cyan,magenta,green,yellow,blue\" \"npm run gateway\" \"npm run auth\" \"npm run habits\" \"npm run analytics\" \"npm run notifications\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "gateway": "npm --prefix services/api-gateway run dev",
    "auth": "npm --prefix services/auth-service run dev",
    "habits": "npm --prefix services/habit-service run dev",
    "analytics": "npm --prefix services/analytics-service run dev",
    "notifications": "npm --prefix services/notification-service run dev",
    "client": "npm --prefix frontend run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kashishkhan-07/StreakUp-Microservices-Based-Habit-Tracking-Platform.git"
  },
  "keywords": [
    "microservices",
    "habit-tracker",
    "nodejs",
    "react",
    "rabbitmq"
  ],
  "author": "kashishkhan-07",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kashishkhan-07/StreakUp-Microservices-Based-Habit-Tracking-Platform/issues"
  },
  "homepage": "https://github.com/kashishkhan-07/StreakUp-Microservices-Based-Habit-Tracking-Platform#readme",
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
