{
  "name": "streakup-monorepo",
  "version": "1.0.0",
  "description": "StreakUp - Microservices-Based Habit Tracking Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "gateway": "npm --workspace=services/api-gateway run dev",
    "auth": "npm --workspace=services/auth-service run dev",
    "habits": "npm --workspace=services/habit-service run dev",
    "analytics": "npm --workspace=services/analytics-service run dev",
    "notifications": "npm --workspace=services/notification-service run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kashishkhan-07/StreakUp-Microservices-Based-Habit-Tracking-Platform.git"
  },
  "keywords": [
    "microservices",
    "habit-tracker",
    "nodejs",
    "react",
    "rabbitmq"
  ],
  "author": "kashishkhan-07",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kashishkhan-07/StreakUp-Microservices-Based-Habit-Tracking-Platform/issues"
  },
  "homepage": "https://github.com/kashishkhan-07/StreakUp-Microservices-Based-Habit-Tracking-Platform#readme"
}