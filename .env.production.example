# ==========================================
# StreakUp Production Environment Variables
# ==========================================

# Master Shared JWT Secret across all microservices
JWT_SECRET=streakup_super_secret_jwt_key_2026_dev

# Frontend Client URL allowed by CORS in API Gateway
CLIENT_URL=https://your-frontend-domain.com

# Frontend API URL (Used during Vite build)
VITE_API_URL=https://your-api-domain.com/api

# RabbitMQ AMQP URI (CloudAMQP or self-hosted)
RABBITMQ_URL=amqps://username:password@cow.rmq2.cloudamqp.com/vhost

# MongoDB Atlas Database URIs (Isolated namespaces)
MONGO_URI_AUTH=mongodb+srv://alex:Password123@cluster0.abcde.mongodb.net/streakup_auth?retryWrites=true&w=majority
MONGO_URI_HABITS=mongodb+srv://alex:Password123@cluster0.abcde.mongodb.net/streakup_habits?retryWrites=true&w=majority
MONGO_URI_ANALYTICS=mongodb+srv://alex:Password123@cluster0.abcde.mongodb.net/streakup_analytics?retryWrites=true&w=majority
MONGO_URI_NOTIFICATIONS=mongodb+srv://alex:Password123@cluster0.abcde.mongodb.net/streakup_notifications?retryWrites=true&w=majority
